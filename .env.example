# Live mode. Copy to .env.local (git-ignored) after running sql/setup.sql.
# Leave this file absent to run on the bundled synthetic data with no account.

# Account identifier in <org>-<account> form, and the user that ran setup.sql
# (setup grants CAV_DEMO_ROLE to that user).
SNOWFLAKE_ACCOUNT=<orgname>-<account_name>
SNOWFLAKE_USERNAME=<YOUR_USER>

# Key-pair authentication (recommended). Keep the key outside the repository.
#   openssl genrsa 2048 | openssl pkcs8 -topk8 -inform PEM -out ~/.snowflake/keys/cav_rsa_key.p8 -nocrypt
#   openssl rsa -in ~/.snowflake/keys/cav_rsa_key.p8 -pubout
#   ALTER USER <YOUR_USER> SET RSA_PUBLIC_KEY_2 = '<public key body>';
SNOWFLAKE_PRIVATE_KEY_PATH=/absolute/path/to/cav_rsa_key.p8
# Or a programmatic access token instead of a key:
# SNOWFLAKE_TOKEN=<token>

# Optional overrides (defaults shown)
# SNOWFLAKE_ROLE=CAV_DEMO_ROLE
# SNOWFLAKE_DATABASE=CLIENT_VIEWS_DEMO
# SNOWFLAKE_WAREHOUSE=CAV_IWH
# SNOWFLAKE_STANDARD_WAREHOUSE=CAV_WH
# SNOWFLAKE_POOL_MAX=32
# SNOWFLAKE_COMPLETE_MODEL=claude-sonnet-4-5
